{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "bash": {
      "npm test": "allow",
      "npm test *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git push *": "ask",
      "npm install *": "ask",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "*": "ask"
    },
    "edit": "ask",
    "webfetch": "ask"
  },
  "deniedPaths": [
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*_key"
  ]
}
